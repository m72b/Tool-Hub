{
  "name": "m72b-tool-hub",
  "version": "3.0.0",
  "author": "m72b",
  "description": "m72b Tool Hub - modular file, cleanup and system utilities",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/all.js",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.m72b.toolhub",
    "productName": "m72b Tool Hub",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "m72b-tool-hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ]
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
