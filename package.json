{
  "name": "tool-hub",
  "version": "5.2.0",
  "author": "m72b",
  "description": "Tool Hub - modular file, cleanup and system utilities",
  "main": "main.js",
  "bin": {
    "toolhub": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "toolhub": "node cli.js",
    "test": "node test/all.js",
    "build-win": "npm run addons && electron-builder --win",
    "build-mac": "npm run addons && electron-builder --mac",
    "build-linux": "npm run addons && electron-builder --linux",
    "addon:keygen": "node scripts/addon-keygen.js",
    "addon:build": "node scripts/build-addon.js",
    "addons": "node scripts/build-all.js",
    "icon": "electron scripts/render-icon.js"
  },
  "build": {
    "appId": "com.m72b.toolhub",
    "productName": "Tool Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "tool-hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "main.js",
      "cli.js",
      "preload.js",
      "assets/**",
      "src/**"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "extraResources": [
      {
        "from": "dist/bundled",
        "to": "addons"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "pdfjs-dist": "^3.11.174"
  },
  "dependencies": {
    "music-metadata": "^11.16.1"
  }
}
