{
  "name": "tool-hub",
  "version": "3.0.0",
  "author": "m72b",
  "description": "m72b Tool Hub - modular file, cleanup and system utilities",
  "main": "main.js",
  "bin": { "toolhub": "./cli.js" },
  "scripts": {
    "start": "electron .",
    "toolhub": "node cli.js",
    "test": "node test/all.js",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.m72b.toolhub",
    "productName": "m72b Tool Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "m72b-tool-hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "main.js",
      "cli.js",
      "preload.js",
      "assets/**",
      "src/**"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "music-metadata": "^11.16.1"
  }
}
